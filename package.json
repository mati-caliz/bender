{
  "name": "bender",
  "version": "1.1.0",
  "private": true,
  "description": "Extension MV3 para manipular headers, cookies, storage y trafico de red",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build:app && npm run build:content",
    "build:app": "vite build",
    "build:content": "node scripts/build-content.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently \"node scripts/build-content.mjs --watch\" \"vite build --watch\"",
    "icons": "python3 scripts/generate-icons.py public/icons",
    "lint": "eslint . --max-warnings 0",
    "screenshots": "powershell -ExecutionPolicy Bypass -File scripts/fit-screenshots.ps1",
    "screenshots:capture": "playwright test --config playwright.capture.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
