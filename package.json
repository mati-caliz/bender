{
  "name": "bender",
  "version": "1.0.0",
  "private": true,
  "description": "Extension MV3 para manipular headers, cookies, storage y trafico de red",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build:app && npm run build:content",
    "build:app": "vite build",
    "build:content": "node scripts/build-content.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently \"node scripts/build-content.mjs --watch\" \"vite build --watch\"",
    "icons": "python3 scripts/generate-icons.py public/icons",
    "screenshots": "powershell -ExecutionPolicy Bypass -File scripts/fit-screenshots.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
