{
  "name": "bender",
  "version": "1.1.0",
  "private": true,
  "description": "Extension MV3 para manipular headers, cookies, storage y trafico de red",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:app && pnpm run build:content",
    "build:app": "vite build",
    "build:content": "node scripts/build-content.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently \"node scripts/build-content.mjs --watch\" \"vite build --watch\"",
    "icons": "python3 scripts/generate-icons.py public/icons",
    "lint": "eslint --max-warnings 0",
    "screenshots": "powershell -ExecutionPolicy Bypass -File scripts/fit-screenshots.ps1",
    "screenshots:capture": "playwright test --config playwright.capture.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "node_modules/typescript7/bin/tsc --noEmit",
    "zip": "node scripts/zip.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "quality:check": "bash ../infra/quality/sync.sh . --check",
    "verify": "pnpm quality:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
